---
// Starlight <head> override: the default tags (title, description, canonical,
// Open Graph, sitemap link, plus the site-wide entries from astro.config.mjs),
// followed by per-page structured data in the shapes the webapp's own pages
// use (client/src/seo/jsonLd.js): a TechArticle for each docs page and a
// BreadcrumbList back to the docs home. The splash page carries only the
// site-wide graph.
import Default from '@astrojs/starlight/components/Head.astro';
import {
	absoluteUrl,
	jsonLdText,
	OG_IMAGE,
	ORGANISATION_ID,
	SITE_TITLE,
	WEBAPP_ID,
	WEBSITE_ID,
} from '../seo.mjs';

const { entry, lastUpdated, sidebar } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// The sidebar group the current page sits in ("Guides", "Reference"), for
// articleSection. Groups have no page of their own, so they are not a crumb.
function sectionOf(items) {
	for (const item of items) {
		if (item.type !== 'group') continue;
		if (item.entries.some((child) => child.type === 'link' && child.isCurrent)) return item.label;
		const nested = sectionOf(item.entries);
		if (nested) return nested;
	}
	return undefined;
}

const jsonLd =
	isSplash || !canonical
		? []
		: [
				{
					'@context': 'https://schema.org',
					'@type': 'TechArticle',
					headline: entry.data.title,
					name: entry.data.title,
					description: entry.data.description,
					url: canonical,
					image: absoluteUrl(OG_IMAGE.path),
					inLanguage: 'en',
					articleSection: sectionOf(sidebar),
					dateModified: lastUpdated?.toISOString(),
					isAccessibleForFree: true,
					publisher: { '@id': ORGANISATION_ID },
					isPartOf: { '@id': WEBSITE_ID },
					about: { '@id': WEBAPP_ID },
				},
				{
					'@context': 'https://schema.org',
					'@type': 'BreadcrumbList',
					itemListElement: [
						{ '@type': 'ListItem', position: 1, name: SITE_TITLE, item: absoluteUrl('/') },
						{ '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical },
					],
				},
			];
---

<Default />
{jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={jsonLdText(item)} />)}
